# Local development or hosting-service variables. Never commit real values.
DATABASE_URL=jdbc:mysql://localhost:3306/careerforge
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGIN=http://127.0.0.1:5173
JPA_DDL_AUTO=update
OPENAI_API_KEY=
OPENAI_MODEL=

# Set up a transactional email provider, then enable password recovery.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FRONTEND_URL=https://your-public-frontend.example
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
